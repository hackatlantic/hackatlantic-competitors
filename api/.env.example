HTTP_ADDRESS=:8080
DATABASE_URL=postgres://hackatlantic:hackatlantic@localhost:5432/hackatlantic?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_QUERY_TIMEOUT=5s
DATABASE_TRANSACTION_TIMEOUT=15s
APP_BASE_URL=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWKS_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production only: comma-separated CIDRs for proxies that set X-Forwarded-For.
# Leave empty when clients connect directly; untrusted forwarding headers are ignored.
TRUSTED_PROXY_CIDRS=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Local development stores PDFs here. Production should instead configure the
# three private Supabase Storage variables below.
RESUME_STORAGE_DIRECTORY=.data/resumes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESUME_STORAGE_BUCKET=
# Required: distinct standard-base64 values containing at least 32 random bytes.
# Generate each independently, for example: openssl rand -base64 32
# Keep them server-only and do not rotate them without a pass migration plan.
QR_TOKEN_PEPPER=
CLAIM_TOKEN_PEPPER=
