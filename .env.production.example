# Public frontend build values
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
DEPLOYMENT_ENVIRONMENT=production
APP_VERSION=sha-replace_me
GIT_SHA=replace_me

# Frontend server secret
CLERK_SECRET_KEY=sk_live_replace_me

# Go API
HTTP_ADDRESS=:8080
APP_BASE_URL=https://apply.example.com
CORS_ALLOWED_ORIGINS=https://apply.example.com
CLERK_ISSUER_URL=https://clerk.example.com
CLERK_AUTHORIZED_PARTIES=https://apply.example.com
CLERK_JWKS_URL=https://clerk.example.com/.well-known/jwks.json
QR_TOKEN_PEPPER=replace_with_base64_of_32_random_bytes
CLAIM_TOKEN_PEPPER=replace_with_different_base64_of_32_random_bytes
TRUSTED_PROXY_CIDRS=
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=tor1
SPACES_BUCKET=hackatlantic-resumes
SPACES_ACCESS_KEY_ID=replace_with_limited_spaces_access_key
SPACES_SECRET_ACCESS_KEY=replace_with_spaces_secret_key
DATABASE_MAX_CONNS=10
DATABASE_QUERY_TIMEOUT=5s
DATABASE_TRANSACTION_TIMEOUT=15s

# Use a persistent direct or session-pooler connection for the Go API.
DATABASE_URL=postgresql://application_role:password@host:5432/postgres?sslmode=require
DATABASE_ROLE=hackatlantic_app
# Use a migration-owner direct connection for the one-shot migration job.
MIGRATION_DATABASE_URL=postgresql://migration_owner:password@host:5432/postgres?sslmode=require

# Delivery adapter configuration; the outbox worker is a separate deployment unit.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Start with metrics only. Use the actual Grafana stack OTLP URL with /v1/metrics.
# Headers contain a write-only metrics token; store them as a runtime secret.
# Leave blank until configured. See docs/runbooks/grafana-essentials.md.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# A global endpoint enables ALL three signals; keep it blank for metrics-only mode.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
