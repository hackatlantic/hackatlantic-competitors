{
  "name": "hackatlantic-competitors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:windows": "pwsh -NoProfile -File scripts/dev-windows.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:components": "vitest run",
    "api:dev": "go -C api run ./cmd/server",
    "api:migrate": "go -C api run ./cmd/migrate",
    "api:bootstrap-organizer": "go -C api run ./cmd/bootstrap-organizer",
    "api:seed-intake": "go -C api run ./cmd/seed-intake",
    "api:test": "go -C api test -p 1 ./...",
    "api:test:integration": "docker compose -f docker-compose.integration.yml down --volumes --remove-orphans && docker compose -f docker-compose.integration.yml up --build --abort-on-container-exit --exit-code-from api-integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@vercel/otel": "2.1.3",
    "@zxing/browser": "0.2.1",
    "framer-motion": "^13.0.0",
    "next": "16.3.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@clerk/backend": "^3.6.1",
    "@clerk/testing": "^2.2.19",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "clerk": "^3.0.0",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "30.0.1",
    "typescript": "latest",
    "vitest": "4.1.10"
  }
}
