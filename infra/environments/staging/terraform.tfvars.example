api_image_digest          = "sha256:replace-with-64-hex-characters"
supabase_organization_id  = "replace-me"
supabase_database_password = "replace-me"
digitalocean_alert_emails = ["dacodegen@gmail.com"]

api_env = {
  DATABASE_MAX_CONNS               = "5"
  DATABASE_QUERY_TIMEOUT           = "5s"
  DATABASE_TRANSACTION_TIMEOUT     = "15s"
  APP_BASE_URL                     = "https://hackatlantic-competitors-git-staging-hackatlantic.vercel.app"
  CORS_ALLOWED_ORIGINS             = "https://hackatlantic-competitors-git-staging-hackatlantic.vercel.app"
  CLERK_SECRET_KEY                 = "replace-me"
  CLERK_ISSUER_URL                 = "replace-me"
  CLERK_AUTHORIZED_PARTIES         = "https://hackatlantic-competitors-git-staging-hackatlantic.vercel.app"
  QR_TOKEN_PEPPER                  = "replace-me"
  CLAIM_TOKEN_PEPPER               = "replace-me"
  SPACES_ENDPOINT                  = "https://tor1.digitaloceanspaces.com"
  SPACES_REGION                    = "tor1"
  SPACES_BUCKET                    = "hackatlantic-resumes-staging"
  SPACES_ACCESS_KEY_ID             = "replace-me"
  SPACES_SECRET_ACCESS_KEY         = "replace-me"
  APP_VERSION                      = "staging"
  DEPLOYMENT_ENVIRONMENT           = "staging"
}

# Keep exporter credentials outside the main api_env payload. This exact map is
# supplied through the protected API_OBSERVABILITY_ENV_JSON environment secret.
api_observability_env = {
  OTEL_EXPORTER_OTLP_METRICS_ENDPOINT = ""
  OTEL_EXPORTER_OTLP_METRICS_HEADERS  = ""
  OTEL_EXPORTER_OTLP_PROTOCOL         = "http/protobuf"
  OTEL_EXPORTER_OTLP_ENDPOINT         = ""
  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT  = ""
  OTEL_EXPORTER_OTLP_LOGS_ENDPOINT    = ""
}
